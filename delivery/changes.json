    {
      "file": "assets/ta-vie-home.css",
      "status": "added",
      "sha256": "2ecc4ed4d5ddc66fc200c29100e5c6e446ecd44dee5804d05069520be7f2bd91",
      "patch": "--- original/assets/ta-vie-home.css\n+++ edited/assets/ta-vie-home.css\n@@ -0,0 +1,83 @@\n+/*\n+ * TA VIE home-page additions only.\n+ * Keep Broadcast's fonts, editor-selected sizes and color schemes intact.\n+ * Product cards and purchase controls retain their native styles.\n+ * ID suffixes match the native sections created in templates/index.json.\n+ */\n+\n+body.template-index #MainContent :is(\n+  section[id$=\"ta_vie_intro\"],\n+  section[id$=\"ta_vie_story\"],\n+  section[id$=\"ta_vie_reading\"]\n+) .hero__title,\n+body.template-index #MainContent section[id$=\"ta_vie_products\"] .grid__heading,\n+body.template-index #MainContent section[id$=\"ta_vie_blog\"] .blog__title {\n+  line-height: 1.65;\n+  letter-spacing: 0.04em;\n+  overflow-wrap: anywhere;\n+}\n+\n+body.template-index #MainContent :is(\n+  section[id$=\"ta_vie_intro\"],\n+  section[id$=\"ta_vie_story\"],\n+  section[id$=\"ta_vie_reading\"]\n+) .hero__rte,\n+body.template-index #MainContent section[id$=\"ta_vie_products\"] .grid__description {\n+  line-height: 1.9;\n+  letter-spacing: 0.015em;\n+  overflow-wrap: anywhere;\n+}\n+\n+body.template-index #MainContent :is(\n+  section[id$=\"ta_vie_intro\"],\n+  section[id$=\"ta_vie_story\"],\n+  section[id$=\"ta_vie_reading\"]\n+) .hero__rte p,\n+body.template-index #MainContent section[id$=\"ta_vie_products\"] .grid__description p {\n+  line-height: inherit;\n+}\n+\n+/*\n+ * These editorial sections should remain readable if the theme's animation\n+ * script has not run. The product-grid override covers its heading only.\n+ */\n+body.template-index #MainContent :is(\n+  section[id$=\"ta_vie_intro\"],\n+  section[id$=\"ta_vie_story\"],\n+  section[id$=\"ta_vie_reading\"],\n+  section[id$=\"ta_vie_blog\"]\n+) [data-aos],\n+body.template-index #MainContent section[id$=\"ta_vie_products\"] .grid__heading-holder [data-aos] {\n+  opacity: 1;\n+  visibility: visible;\n+  transform: none;\n+  animation: none;\n+  transition: none;\n+}\n+\n+@media only screen and (max-width: 749px) {\n+  /* Honor the native 1/2-column mobile selection on wide phones as well. */\n+  body.template-index #MainContent section[id$=\"ta_vie_products\"] .grid--mobile-vertical {\n+    --columns: var(--COLUMNS-MOBILE);\n+  }\n+\n+  body.template-index #MainContent :is(\n+    section[id$=\"ta_vie_intro\"],\n+    section[id$=\"ta_vie_story\"],\n+    section[id$=\"ta_vie_products\"],\n+    section[id$=\"ta_vie_reading\"],\n+    section[id$=\"ta_vie_blog\"]\n+  ) {\n+    --padding-top: min(32px, calc(var(--PT, 48px) * 0.6));\n+    --padding-bottom: min(36px, calc(var(--PB, 48px) * 0.6));\n+    --PT-MOBILE: var(--padding-top);\n+  }\n+\n+  body.template-index #MainContent :is(\n+    section[id$=\"ta_vie_intro\"],\n+    section[id$=\"ta_vie_story\"],\n+    section[id$=\"ta_vie_reading\"]\n+  ) .hero__content__wrapper {\n+    padding-inline: 20px;\n+  }\n+}\n"
    }
  ]
}
