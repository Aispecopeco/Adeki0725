{%- doc -%}
  Existing blog and FAQ destinations shared by desktop, mobile, toolbar, home and footer.
  @param {string} location - desktop, mobile, toolbar, home or footer.
  @param {link[]} [menu_links] - Existing links used to avoid duplicate destinations.
  @param {block[]} [menu_blocks] - Existing mobile menu blocks.
{%- enddoc -%}
{%- liquid
  assign navigation_enabled = settings.ta_vie_navigation_links | default: true, allow_false: true
  assign home_enabled = settings.ta_vie_home_links | default: true, allow_false: true
  assign show_links = navigation_enabled
  if location == 'home'
    assign show_links = home_enabled
  elsif location == 'footer' or location == 'toolbar'
    assign show_links = true
  endif

  assign reading_blog = settings.ta_vie_blog
  if reading_blog != blank and reading_blog.url == blank
    assign reading_blog = blogs[settings.ta_vie_blog]
  endif
  if settings.ta_vie_blog == blank and blogs.news.url != blank
    assign reading_blog = blogs.news
  endif

  assign faq_page = settings.ta_vie_faq_page
  if faq_page != blank and faq_page.url == blank
    assign faq_page = pages[settings.ta_vie_faq_page]
  endif
  if settings.ta_vie_faq_page == blank
    assign faq_page = pages.faq
    if faq_page.url == blank
      for candidate in pages limit: 50
        if candidate.template_suffix == 'faq' and candidate.url != blank
          assign faq_page = candidate
          break
        endif
      endfor
    endif
  endif

  capture existing_destinations
    render 'ta-vie-menu-destinations', links: menu_links
    if location == 'mobile'
      for menu_block in menu_blocks
        if menu_block.type == 'menu' or menu_block.type == 'menu-columns'
          assign menu_handle = menu_block.settings.mobile_menu_linklist | default: 'main-menu'
          render 'ta-vie-menu-destinations', links: linklists[menu_handle].links
        endif
      endfor
    endif
  endcapture

  assign destinations = 'blog,faq' | split: ','
  assign has_missing_destination = false
-%}
{%- capture links_markup -%}
  {%- if show_links -%}
    {%- for destination in destinations -%}
      {%- liquid
        if destination == 'blog'
          assign resource = reading_blog
          assign link_label = settings.ta_vie_blog_label | default: 'ブログ'
          assign resource_type = 'blog_link'
          assign explicit_url = settings.ta_vie_blog_url
        else
          assign resource = faq_page
          assign link_label = settings.ta_vie_faq_label | default: 'よくあるご質問'
          assign resource_type = 'page_link'
          assign explicit_url = settings.ta_vie_faq_url
        endif

        assign destination_url = resource.url
        assign destination_id = resource.id
        if explicit_url != blank
          assign destination_url = explicit_url
          assign destination_id = blank
        endif
        assign already_linked = false
        capture url_token
          echo '|' | append: destination_url | append: '|'
        endcapture
        capture id_token
          echo '|' | append: resource_type | append: ':' | append: destination_id | append: '|'
        endcapture
        if location != 'home'
          if existing_destinations contains url_token
            assign already_linked = true
          elsif destination_id != blank and existing_destinations contains id_token
            assign already_linked = true
          endif
        endif
      -%}
      {%- if destination_url != blank and already_linked == false -%}
        {%- case location -%}
          {%- when 'desktop' -%}
            <div class="menu__item child">
              <a href="{{ destination_url | escape }}" data-top-link class="navlink navlink--toplevel"{% if request.path == destination_url %} aria-current="page"{% endif %}>
                <span class="navtext">{{ link_label | escape }}</span>
              </a>
            </div>
          {%- when 'mobile' -%}
            <div class="sliderule__wrapper">
              <div class="sliderow" data-animates="0" data-animation="drawer-items-fade" data-animation-duration="500" data-animation-delay="{{ forloop.index | times: 50 | plus: 250 }}">
                <a class="sliderow__title" href="{{ destination_url | escape }}"{% if request.path == destination_url %} aria-current="page"{% endif %}><span>{{ link_label | escape }}</span></a>
              </div>
            </div>
          {%- when 'footer' -%}
            <li><a href="{{ destination_url | escape }}"{% if request.path == destination_url %} aria-current="page"{% endif %}>{{ link_label | escape }}</a></li>
          {%- when 'toolbar' -%}
            <a href="{{ destination_url | escape }}" class="navlink navlink--toplevel"{% if request.path == destination_url %} aria-current="page"{% endif %}><span class="navtext">{{ link_label | escape }}</span></a>
          {%- when 'home' -%}
            <div class="hero__button">
              <a href="{{ destination_url | escape }}" class="btn btn--small btn--outline btn--primary"><span>{{ link_label | escape }}</span></a>
            </div>
        {%- endcase -%}
      {%- elsif destination_url == blank and location == 'home' and request.design_mode -%}
        {%- assign has_missing_destination = true -%}
        <div class="hero__button">
          <span class="btn btn--small btn--outline btn--primary" aria-disabled="true">{{ link_label | escape }}（リンク先未設定）</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- if links_markup != blank -%}
  {%- if location == 'home' -%}
    <nav class="wrapper--narrow section-padding text-center color-scheme-tavie-white" style="--PT: 24px; --PB: 24px;" aria-label="ブログとご案内">
      <div class="hero__button-group">{{ links_markup }}</div>
      {%- if has_missing_destination -%}
        <p>テーマ設定「TA VIE｜ページへのリンク」で、ブログとFAQのリンク先を選択してください。URLを入力して設定することもできます。</p>
      {%- endif -%}
    </nav>
  {%- elsif location == 'footer' -%}
    <ul class="footer__quicklinks unstyled">{{ links_markup }}</ul>
  {%- else -%}
    {{- links_markup -}}
  {%- endif -%}
{%- endif -%}
