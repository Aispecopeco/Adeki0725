{%- comment -%}
  Size values include the merchant's own units. Empty / foreign-product rows
  and entirely empty measurement columns are omitted.
{%- endcomment -%}
{%- liquid
  assign feature_size_count = 0
  assign feature_table_label = table_label | default: '商品実寸'
  assign size_length = false
  assign size_chest = false
  assign size_sleeve = false
  assign size_waist = false
  assign size_inseam = false
  for row in rows
    if product.id != blank and row.owner_product.value.id == product.id and row.label.value != blank and feature_size_count < 12
      if row.length.value != blank or row.chest.value != blank or row.sleeve.value != blank or row.waist.value != blank or row.inseam.value != blank
        assign feature_size_count = feature_size_count | plus: 1
        if row.length.value != blank
          assign size_length = true
        endif
        if row.chest.value != blank
          assign size_chest = true
        endif
        if row.sleeve.value != blank
          assign size_sleeve = true
        endif
        if row.waist.value != blank
          assign size_waist = true
        endif
        if row.inseam.value != blank
          assign size_inseam = true
        endif
      endif
    endif
  endfor
-%}
{%- if feature_size_count > 0 -%}
  <div class="ta-vie-feature__table-wrap" tabindex="0" role="region" aria-label="{{ feature_table_label | escape }}">
    <table class="ta-vie-feature__table">
      <caption>{{ feature_table_label | escape }}</caption>
      <thead>
        <tr>
          <th scope="col">サイズ</th>
          {%- if size_length -%}<th scope="col">着丈</th>{%- endif -%}
          {%- if size_chest -%}<th scope="col">身幅</th>{%- endif -%}
          {%- if size_sleeve -%}<th scope="col">袖丈</th>{%- endif -%}
          {%- if size_waist -%}<th scope="col">ウエスト</th>{%- endif -%}
          {%- if size_inseam -%}<th scope="col">股下</th>{%- endif -%}
        </tr>
      </thead>
      <tbody>
        {%- assign feature_size_count = 0 -%}
        {%- for row in rows -%}
          {%- if product.id != blank and row.owner_product.value.id == product.id and row.label.value != blank and feature_size_count < 12 -%}
            {%- if row.length.value != blank or row.chest.value != blank or row.sleeve.value != blank or row.waist.value != blank or row.inseam.value != blank -%}
              {%- assign feature_size_count = feature_size_count | plus: 1 -%}
              <tr>
                <th scope="row">{{ row.label.value | escape }}</th>
                {%- if size_length -%}<td>{{ row.length.value | default: '—' | escape }}</td>{%- endif -%}
                {%- if size_chest -%}<td>{{ row.chest.value | default: '—' | escape }}</td>{%- endif -%}
                {%- if size_sleeve -%}<td>{{ row.sleeve.value | default: '—' | escape }}</td>{%- endif -%}
                {%- if size_waist -%}<td>{{ row.waist.value | default: '—' | escape }}</td>{%- endif -%}
                {%- if size_inseam -%}<td>{{ row.inseam.value | default: '—' | escape }}</td>{%- endif -%}
              </tr>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
{%- endif -%}
