{%- comment -%}
  Assets belong to the added sections. No layout, global theme setting,
  native product markup, or native cart modification is required.
  Usage: render 'ta-vie-luxury-assets', context: 'home' or 'product'.
{%- endcomment -%}
{{ 'ta-vie-additions.css' | asset_url | stylesheet_tag }}
{{ 'ta-vie-luxury-explorer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ta-vie-luxury-explorer.js' | asset_url }}" defer="defer"></script>
{%- if context == 'home' -%}
  {{ 'ta-vie-luxury-home.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ta-vie-luxury-home.js' | asset_url }}" defer="defer"></script>
{%- elsif context == 'product' -%}
  {{ 'ta-vie-product-world.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ta-vie-product-world.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
