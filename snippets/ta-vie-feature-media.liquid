{%- comment -%}
  Product feature media. Only actual product-owned file references are passed in.
  image / mobile_image: Image or MediaImage; video: Shopify-hosted Video.
{%- endcomment -%}
{%- liquid
  assign feature_image = image
  assign feature_mobile_image = mobile_image
  assign feature_video = video
  if feature_image.media_type == 'image' and feature_image.preview_image != blank
    assign feature_image = feature_image.preview_image
  endif
  if feature_mobile_image.media_type == 'image' and feature_mobile_image.preview_image != blank
    assign feature_mobile_image = feature_mobile_image.preview_image
  endif
  if feature_image.width == blank
    assign feature_image = nil
  endif
  if feature_mobile_image.width == blank
    assign feature_mobile_image = nil
  endif
  unless feature_video.media_type == 'video'
    assign feature_video = nil
  endunless
  if feature_image == blank and feature_mobile_image != blank
    assign feature_image = feature_mobile_image
    assign feature_mobile_image = nil
  endif
  assign feature_sizes = '(min-width: 990px) 55vw, calc(100vw - 40px)'
-%}
{%- if feature_video != blank -%}
  <div class="ta-vie-feature__media ta-vie-feature__media--video">
    {%- if feature_image != blank -%}
      {%- assign feature_poster = feature_image | image_url: width: 1800 -%}
      {{- feature_video | video_tag: controls: true, autoplay: false, loop: false, playsinline: true, preload: 'none', image_size: '1800x', poster: feature_poster, class: 'ta-vie-feature__video' -}}
    {%- else -%}
      {{- feature_video | video_tag: controls: true, autoplay: false, loop: false, playsinline: true, preload: 'none', image_size: '1800x', class: 'ta-vie-feature__video' -}}
    {%- endif -%}
  </div>
{%- elsif feature_image != blank -%}
  <figure class="ta-vie-feature__media">
    <picture>
      {%- if feature_mobile_image != blank and feature_mobile_image != feature_image -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ feature_mobile_image | image_url: width: 360 }} 360w, {{ feature_mobile_image | image_url: width: 540 }} 540w, {{ feature_mobile_image | image_url: width: 750 }} 750w, {{ feature_mobile_image | image_url: width: 1100 }} 1100w"
          sizes="calc(100vw - 40px)"
          width="{{ feature_mobile_image.width }}"
          height="{{ feature_mobile_image.height }}"
        >
      {%- endif -%}
      {{- feature_image | image_url: width: 2200 | image_tag: widths: '360, 540, 750, 1100, 1500, 1800, 2200', sizes: feature_sizes, loading: 'lazy', alt: feature_image.alt, class: 'ta-vie-feature__image' -}}
    </picture>
  </figure>
{%- endif -%}
