{% comment %}
  Renders header toolbar block

  Accepts:
  - block: {Object} Toolbar block object (required)

  Usage:
  {% render 'header-toolbar', block: toolbar_block %}
{% endcomment %}

{%- liquid
  assign show_toolbar = false
  assign show_utilities = false
  assign show_toolbar_menu = false

  if block
    assign show_toolbar = true
    assign text = block.settings.text
    assign menu = block.settings.menu
    assign menu_links = linklists[menu].links
    assign languages = false
    assign countries = false
    assign show_locale_selector = block.settings.show_locale_selector
    assign show_locale_code = block.settings.show_locale_code
    assign show_globe_icon = block.settings.show_globe_icon
    assign show_country_selector = block.settings.show_country_selector
    assign show_country_name = block.settings.show_country_name
    assign show_country_flag = block.settings.show_country_flag
    assign show_toolbar_socials = block.settings.show_social_links
    assign show_toolbar_gift_card = block.settings.show_gift_card
    assign show_ta_vie_links = block.settings.show_ta_vie_links | default: true, allow_false: true
    assign show_mobile_toolbar = block.settings.show_mobile_toolbar | default: true, allow_false: true
    assign show_language_label = false
    assign show_border = block.settings.show_border
    assign border_color = block.settings.border_color
    assign border_opacity = block.settings.border_opacity | times: 0.01
    assign color_scheme = 'color-' | append: block.settings.color_scheme
    assign root_url = routes.root_url
    if root_url != '/'
      assign root_url = root_url | append: '/'
    endif

    if menu_links.size > 0
      assign show_toolbar_menu = true
    endif

    if show_locale_selector and localization.available_languages.size > 1
      assign languages = true
    elsif show_locale_selector and localization.language.endonym_name != blank
      assign show_language_label = true
    endif

    if show_country_selector and localization.available_countries.size > 1
      assign countries = true
    endif

    if show_toolbar_socials
      assign has_social_account = false
      assign social_accounts = 'instagram,facebook,twitter,tiktok,pinterest,tumblr,youtube,vimeo,linkedin,snapchat,feed' | split: ','
      for social_account in social_accounts
        assign social_setting = social_account | append: '_link'
        if settings[social_setting] != blank
          assign has_social_account = true
          break
        endif
      endfor
      assign show_toolbar_socials = has_social_account
    endif

    if languages or countries or show_language_label or show_toolbar_socials or show_toolbar_gift_card
      assign show_utilities = true
    endif

    capture style
      echo '--PT: ' | append: block.settings.padding_top | append: 'px;'
      echo '--PB: ' | append: block.settings.padding_bottom | append: 'px;'

      if show_border
        unless border_color.alpha == 0.0 or border_color == blank
          echo '--border-color: ' | append: border_color | append: ';'
        endunless
        echo '--border-opacity: ' | append: border_opacity | append: ';'
      endif
    endcapture
  endif
-%}

{%- capture toolbar_menu -%}
  {%- if show_toolbar_menu -%}
    {%- for link in menu_links -%}
      <a href="{{ link.url }}" class="navlink navlink--toplevel">{{ link.title }}</a>
    {%- endfor -%}
  {%- endif -%}
  {%- if block and show_ta_vie_links -%}
    {%- render 'ta-vie-page-links', location: 'toolbar', menu_links: menu_links -%}
  {%- endif -%}
{%- endcapture -%}
{%- if toolbar_menu != blank -%}
  {%- assign show_toolbar_menu = true -%}
{%- endif -%}

{%- capture gift_card_link -%}
  <div class="toolbar__utility">
    <a class="gift-card-link" href="{{ root_url }}products/{{ 'layout.header.gift_card_url' | t }}">{{ 'layout.header.gift_card' | t }}</a>
  </div>
{%- endcapture -%}

{%- capture utilities -%}
  {%- if show_utilities -%}
    {%- if show_toolbar_socials -%}
      <div class="toolbar__utility">
        {%- render 'social-icons' -%}
      </div>
    {%- endif -%}

    {%- if show_toolbar_gift_card -%}
      {{ gift_card_link }}
    {%- endif -%}

    {%- if show_language_label -%}
      <div class="toolbar__utility toolbar__language-label" lang="{{ localization.language.iso_code | escape }}">
        {%- if show_globe_icon -%}
          <span class="popout__icon-globe">{%- render 'icon-globe' -%}</span>
        {%- endif -%}
        <span>
          {%- if show_locale_code -%}
            {{- localization.language.iso_code | upcase | escape -}}
          {%- else -%}
            {{- localization.language.endonym_name | capitalize | escape -}}
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    {%- if languages or countries -%}
      <div class="toolbar__utility">
        {%- render 'localization',
          unique: block.id,
          show_locale_selector: show_locale_selector,
          show_locale_code: show_locale_code,
          show_globe_icon: show_globe_icon,
          show_country_selector: show_country_selector,
          show_country_flag: show_country_flag,
          show_country_name: show_country_name,
          class: 'header' -%}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- if show_toolbar -%}
  {%- render 'stylesheet', name: 'header-toolbar.css' -%}

  {%- if show_toolbar_menu or show_utilities or text != blank -%}
    {%- style -%}
      #Toolbar--{{ block.id }} .toolbar__language-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        white-space: nowrap;
      }
    {%- endstyle -%}
    {%- if show_mobile_toolbar -%}
      {%- style -%}
        @media only screen and (max-width: 749px) {
          #Toolbar--{{ block.id }} .toolbar__inner {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 4px 16px;
            padding-block: 4px;
          }
          #Toolbar--{{ block.id }} ticker-bar.toolbar__text {
            flex: 1 1 160px;
            min-width: 0;
            margin: 0;
            padding: 0;
            overflow: visible;
          }
          #Toolbar--{{ block.id }} .toolbar__text__frame,
          #Toolbar--{{ block.id }} .toolbar__text__ticker {
            display: block;
            width: 100%;
          }
          #Toolbar--{{ block.id }} .announcement__text {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 16px;
            width: 100%;
            white-space: normal;
            animation: none;
          }
          #Toolbar--{{ block.id }} [data-clone],
          #Toolbar--{{ block.id }} .ticker__comparitor {
            display: none;
          }
          #Toolbar--{{ block.id }} .toolbar__menu {
            flex-wrap: wrap;
            gap: 4px 16px;
            margin: 0;
          }
          #Toolbar--{{ block.id }} .toolbar__menu .navlink--toplevel {
            flex-basis: auto;
            padding: 5px 0;
            white-space: normal;
            overflow-wrap: anywhere;
          }
          #Toolbar--{{ block.id }} .toolbar__utilities {
            display: flex;
            flex: 0 1 auto;
            flex-wrap: wrap;
            align-items: center;
            gap: 4px 16px;
            margin: 0;
            min-width: 0;
          }
          #Toolbar--{{ block.id }} .toolbar__utility .socials {
            flex-wrap: wrap;
          }
        }
      {%- endstyle -%}
    {%- endif -%}
    <div
      id="Toolbar--{{ block.id }}"
      class="toolbar{% if show_border %} has-border{% endif %} section-padding{% if text == blank %} toolbar--no-text{% endif %} {{ color_scheme }}"
      {% if style != blank %}
        style="{{ style }}"
      {% endif %}
      data-header-toolbar
      {{ block.shopify_attributes }}
    >
      <div class="wrapper--full-padded">
        <div class="toolbar__inner{% if text == blank and show_mobile_toolbar == false %} desktop{% endif %}">
          {%- if show_toolbar_menu or text != blank -%}
            <ticker-bar class="toolbar__text">
              <div class="toolbar__text__frame">
                <div data-ticker-scale class="toolbar__text__ticker announcement__scale ticker--unloaded">
                  <div data-ticker-text class="announcement__text">
                    {%- if text != blank -%}
                      <div class="toolbar__text">{{ text }}</div>
                    {%- endif -%}

                    {%- if show_toolbar_menu -%}
                      <div class="toolbar__menu{% unless show_mobile_toolbar %} desktop{% endunless %}">
                        {{ toolbar_menu }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </ticker-bar>
          {%- endif -%}

          {%- if show_utilities -%}
            <div class="toolbar__utilities{% unless show_mobile_toolbar %} desktop{% endunless %}">
              {{ utilities }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
