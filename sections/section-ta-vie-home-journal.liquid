{%- liquid
  assign reading_blog = section.settings.blog | default: settings.tvj_blog | default: settings.ta_vie_blog
  if reading_blog != blank and reading_blog.url == blank
    assign reading_blog = blogs[reading_blog]
  endif
  if reading_blog.url == blank
    assign reading_blog = blogs.news
  endif
  assign reading_blog_url = reading_blog.url
  if section.settings.blog == blank and settings.tvj_blog == blank and settings.ta_vie_blog_url != blank
    assign reading_blog_url = settings.ta_vie_blog_url
  endif
  assign faq_page = section.settings.faq_page | default: settings.ta_vie_faq_page
  if faq_page != blank and faq_page.url == blank
    assign faq_page = pages[faq_page]
  endif
  if faq_page.url == blank
    assign faq_page = pages.faq
    if faq_page.url == blank
      for candidate in pages limit: 50
        if candidate.template_suffix == 'faq' and candidate.url != blank
          assign faq_page = candidate
          break
        endif
      endfor
    endif
  endif
  assign faq_url = faq_page.url
  if section.settings.faq_page == blank and settings.ta_vie_faq_url != blank
    assign faq_url = settings.ta_vie_faq_url
  endif
  assign contact_page = section.settings.contact_page
  if contact_page != blank and contact_page.url == blank
    assign contact_page = pages[contact_page]
  endif
  if contact_page.url == blank
    assign contact_page = pages.contact
  endif
  assign has_resources = false
  if faq_url != blank or contact_page.url != blank
    assign has_resources = true
  endif
  assign article_limit = section.settings.article_count | default: 3
  assign article_count = 0
  assign now_timestamp = 'now' | date: '%s' | plus: 0
  assign source_articles = reading_blog.articles
  if section.settings.article_mode == 'manual'
    assign source_articles = section.settings.articles
  elsif reading_blog_url != reading_blog.url
    assign source_articles = nil
  endif
-%}
{%- render 'stylesheet', name: 'ta-vie-journal.css', blocking: true, async: false, inline: false -%}
{%- render 'stylesheet', name: 'ta-vie-home-journal.css', blocking: true, async: false, inline: false -%}
{%- style -%}
  #TaVieHomeJournal-{{ section.id }} { --tvj-padding-top: {{ section.settings.padding_top }}px; --tvj-padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
<section id="TaVieHomeJournal-{{ section.id }}" class="tvj-home color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}" data-section-type="ta-vie-home-journal" {% if section.settings.heading != blank %}aria-labelledby="TaVieHomeJournalHeading-{{ section.id }}"{% else %}aria-label="Journalとご案内"{% endif %}>
  <div class="tvj-home__inner">
    <div class="tvj-home__introduction">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="tvj-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 id="TaVieHomeJournalHeading-{{ section.id }}" class="tvj-home__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.body != blank -%}<div class="tvj-home__body">{{ section.settings.body }}</div>{%- endif -%}
    </div>
    {%- capture article_cards -%}
      {%- for selected_article in source_articles -%}
        {%- liquid
          assign journal_article = selected_article
          if journal_article != blank and journal_article.url == blank
            assign journal_article = articles[journal_article]
          endif
          assign publication_timestamp = journal_article.published_at | date: '%s' | plus: 0
        -%}
        {%- if journal_article.url != blank and journal_article.published_at != blank and publication_timestamp > 0 and publication_timestamp <= now_timestamp -%}
          {%- render 'ta-vie-journal-card', article: journal_article, show_date: section.settings.show_date, show_updated: section.settings.show_updated, link_label: section.settings.article_link_label -%}
          {%- assign article_count = article_count | plus: 1 -%}
          {%- if article_count >= article_limit -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture journal_link -%}{%- render 'ta-vie-journal-link', label: section.settings.blog_link_label, blog: reading_blog, fallback_url: reading_blog_url -%}{%- endcapture -%}
    {%- if article_count > 0 or journal_link != blank -%}
      <div class="tvj-home__journal">
        {%- if article_count > 0 -%}<div class="tvj-grid">{{ article_cards }}</div>{%- endif -%}
        {%- if journal_link != blank -%}<div class="tvj-home__journal-footer">{{ journal_link }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if has_resources -%}
      <nav class="tvj-home__resources" aria-label="ご購入前のご案内">
        {%- if faq_url != blank -%}
          <div class="tvj-home__resource">
            <p class="tvj-eyebrow">{{ section.settings.faq_eyebrow | escape }}</p>
            <h3 class="tvj-home__resource-heading">{{ section.settings.faq_heading | escape }}</h3>
            {%- if section.settings.faq_body != blank -%}<div class="tvj-home__resource-body">{{ section.settings.faq_body }}</div>{%- endif -%}
            <a href="{{ faq_url | escape }}" class="tvj-link"><span>{{ section.settings.faq_link_label | escape }}</span><span aria-hidden="true">→</span></a>
          </div>
        {%- endif -%}
        {%- if contact_page.url != blank -%}
          <div class="tvj-home__resource">
            <p class="tvj-eyebrow">{{ section.settings.contact_eyebrow | escape }}</p>
            <h3 class="tvj-home__resource-heading">{{ section.settings.contact_heading | escape }}</h3>
            {%- if section.settings.contact_body != blank -%}<div class="tvj-home__resource-body">{{ section.settings.contact_body }}</div>{%- endif -%}
            <a href="{{ contact_page.url | escape }}" class="tvj-link"><span>{{ section.settings.contact_link_label | escape }}</span><span aria-hidden="true">→</span></a>
          </div>
        {%- endif -%}
      </nav>
    {%- endif -%}
    {%- if request.design_mode -%}
      {%- if article_count == 0 or faq_url == blank or contact_page.url == blank -%}
        <div class="tvj-editor-note">
          <p>この案内はテーマエディタ内だけに表示されます。実在する記事・FAQ・お問い合わせだけを表示し、未設定の写真枠や仮リンクは公開しません。</p>
          <ul>
            {%- if article_count == 0 -%}<li>Journal：掲載するブログを選ぶか、記事の選び方を「手動で選択」にして公開済み記事を選択してください。</li>{%- endif -%}
            {%- if faq_url == blank -%}<li>FAQ：公開済みのページを作成してから「よくあるご質問のページ」で選択してください。</li>{%- endif -%}
            {%- if contact_page.url == blank -%}<li>お問い合わせ：公開済みのページを作成してから「お問い合わせのページ」で選択してください。</li>{%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "TA VIE｜Journalとご案内",
  "enabled_on": {"templates": ["index"]},
  "settings": [
    {"type": "header", "content": "Journalの入口"},
    {"type": "text", "id": "eyebrow", "label": "小さな見出し", "default": "LIFE AT HOME"},
    {"type": "text", "id": "heading", "label": "見出し", "default": "Journal"},
    {"type": "richtext", "id": "body", "label": "紹介文", "default": "<p>一着のこと、素材のこと、家で過ごす時間のこと。TA VIEの読みものを、ここから。</p>"},
    {"type": "header", "content": "既存記事の紹介"},
    {"type": "blog", "id": "blog", "label": "掲載するブログ", "info": "未選択ならテーマ設定のJournal用ブログ、既存のTA VIEブログ、newsの順に参照します。元の記事は変更しません。"},
    {"type": "select", "id": "article_mode", "label": "記事の選び方", "options": [{"value": "automatic", "label": "公開日が新しい記事を自動表示"}, {"value": "manual", "label": "手動で選択"}], "default": "automatic"},
    {"type": "article_list", "id": "articles", "label": "手動で紹介する記事", "limit": 6, "info": "手動表示を選んだときに使用します。タイトル・写真・日付・リンクは記事から取得します。"},
    {"type": "range", "id": "article_count", "label": "表示する記事数", "min": 1, "max": 6, "step": 1, "default": 3},
    {"type": "text", "id": "blog_link_label", "label": "Journalへのリンク名", "default": "Journalを読む"},
    {"type": "text", "id": "article_link_label", "label": "記事へのリンク名", "default": "記事を読む"},
    {"type": "checkbox", "id": "show_date", "label": "記事の公開日を表示", "default": true},
    {"type": "checkbox", "id": "show_updated", "label": "記事の最終更新日も表示", "default": false, "info": "公開日とは別に表示します。更新しても自動表示の順番は公開日基準です。"},
    {"type": "header", "content": "よくあるご質問"},
    {"type": "page", "id": "faq_page", "label": "よくあるご質問のページ", "info": "未選択の場合はテーマ設定のFAQ、次にfaqのページを使います。実在するページだけ表示します。"},
    {"type": "text", "id": "faq_eyebrow", "label": "FAQの小さな見出し", "default": "BEFORE YOU CHOOSE"},
    {"type": "text", "id": "faq_heading", "label": "FAQの見出し", "default": "気になることを、確かめて。"},
    {"type": "richtext", "id": "faq_body", "label": "FAQの紹介文", "default": "<p>一着を選ぶ前に。よくあるご質問から、ご購入に必要なご案内をご確認いただけます。</p>"},
    {"type": "text", "id": "faq_link_label", "label": "FAQへのリンク名", "default": "よくあるご質問"},
    {"type": "header", "content": "お問い合わせ"},
    {"type": "page", "id": "contact_page", "label": "お問い合わせのページ", "info": "未選択の場合はcontactのページを使います。ページがない場合、この入口は公開されません。"},
    {"type": "text", "id": "contact_eyebrow", "label": "お問い合わせの小さな見出し", "default": "WE ARE HERE"},
    {"type": "text", "id": "contact_heading", "label": "お問い合わせの見出し", "default": "迷ったときは、ご相談を。"},
    {"type": "richtext", "id": "contact_body", "label": "お問い合わせの紹介文", "default": "<p>商品について、気になることや知りたいこと。お問い合わせページからお聞かせください。</p>"},
    {"type": "text", "id": "contact_link_label", "label": "お問い合わせへのリンク名", "default": "お問い合わせ"},
    {"type": "header", "content": "Instagramの旧設定"},
    {"type": "paragraph", "content": "写真付きのInstagram・ライブ案内は、新しい専用セクションと共通テーマ設定から管理します。以下は従来の設定を保持するための項目です。"},
    {"type": "checkbox", "id": "show_instagram", "label": "従来のInstagram表示設定", "default": true},
    {"type": "text", "id": "instagram_eyebrow", "label": "従来の小さな見出し", "default": "STAY IN TOUCH"},
    {"type": "text", "id": "instagram_heading", "label": "従来の見出し", "default": "TA VIEを、もう少し。"},
    {"type": "richtext", "id": "instagram_body", "label": "従来の紹介文", "default": "<p>TA VIEの発信は、Instagramからもご覧いただけます。</p>"},
    {"type": "text", "id": "instagram_link_label", "label": "従来のリンク名", "default": "Instagramを見る"},
    {"type": "header", "content": "配色と余白"},
    {"type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-tavie-white"},
    {"type": "range", "id": "padding_top", "label": "上の余白", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96},
    {"type": "range", "id": "padding_bottom", "label": "下の余白", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96}
  ],
  "presets": [{"name": "TA VIE｜Journalとご案内"}]
}
{% endschema %}
