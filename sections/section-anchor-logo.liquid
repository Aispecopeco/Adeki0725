<!-- /sections/section-anchor-logo.liquid -->
{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign logo_width = section.settings.logo_width | default: 600
  assign mobile_logo_width = section.settings.mobile_logo_width | default: 280
  capture logo_sizes
    echo '(max-width: 749px) min(' | append: mobile_logo_width | append: 'px, 100vw), min(' | append: logo_width | append: 'px, 100vw)'
  endcapture
-%}

{%- style -%}
  #AnchorLogo--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  #AnchorLogo--{{ section.id }} .anchor-logo__link {
    width: 100%;
    max-width: {{ logo_width }}px;
    margin-inline: auto;
  }

  @media (max-width: 749px) {
    #AnchorLogo--{{ section.id }} .anchor-logo__link {
      max-width: {{ mobile_logo_width }}px;
    }
  }

  .anchor-logo__link { display: block; }
  .anchor-logo__link .svg-placeholder {
    display: block;
    height: 25vh;
  }
{%- endstyle -%}

<section
  id="AnchorLogo--{{ section.id }}"
  class="anchor-logo section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="anchor-logo"
>
  <div class="wrapper--full-padded">
    <a
      href="{{ routes.root_url }}"
      class="anchor-logo__link"
      aria-label="{{ 'general.accessibility.footer_logo' | t }}"
      data-aos="hero"
      data-aos-duration="500"
      data-aos-easing="ease-out-quart"
    >
      {%- if section.settings.logo -%}
        {%- render 'image',
          image: section.settings.logo,
          sizes: logo_sizes,
          desktop_height: 'image-height',
          mobile_height: 'image-height--mobile',
          show_backfill: false
        -%}
      {%- else -%}
        {{ 'logo' | placeholder_svg_tag: 'svg-placeholder' }}
      {%- endif -%}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Image",
      "info": "3200 x 1200px .jpg recommended. [Learn more](http://presidiodev.com/link/broadcast/images)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "ロゴの最大幅（PC）",
      "min": 160,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "ロゴの最大幅（スマホ）",
      "min": 120,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Logo",
      "category": "Layout"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
