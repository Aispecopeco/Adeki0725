<!-- /sections/section-anchor-logo.liquid -->
{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign logo_max_width = section.settings.logo_max_width | default: 420
  assign logo_max_width_mobile = section.settings.logo_max_width_mobile | default: 240
  assign logo_image_width = logo_max_width | times: 2
  capture logo_sizes
    echo '(min-width: 750px) min(' | append: logo_max_width | append: 'px, calc(100vw - 50px)), min(' | append: logo_max_width_mobile | append: 'px, calc(100vw - 32px))'
  endcapture
-%}

{%- style -%}
  #AnchorLogo--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --ta-vie-footer-logo-width: {{ logo_max_width }}px;
  }

  #AnchorLogo--{{ section.id }} .anchor-logo__link {
    display: block;
    width: 100%;
    max-width: var(--ta-vie-footer-logo-width);
    margin-inline: auto;
  }

  #AnchorLogo--{{ section.id }} .anchor-logo__link .image-wrapper {
    width: 100%;
    margin: 0;
  }

  #AnchorLogo--{{ section.id }} .anchor-logo__link img {
    object-fit: contain;
  }

  #AnchorLogo--{{ section.id }} .anchor-logo__link .svg-placeholder {
    display: block;
    width: 100%;
    height: auto;
    max-height: 160px;
  }

  @media (max-width: 749px) {
    #AnchorLogo--{{ section.id }} {
      --ta-vie-footer-logo-width: {{ logo_max_width_mobile }}px;
    }
  }
{%- endstyle -%}

<section
  id="AnchorLogo--{{ section.id }}"
  class="anchor-logo section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="anchor-logo"
>
  <div class="wrapper--full-padded">
    <a
      href="{{ routes.root_url }}"
      class="anchor-logo__link"
      aria-label="{{ 'general.accessibility.footer_logo' | t }}"
      data-aos="hero"
      data-aos-duration="500"
      data-aos-easing="ease-out-quart"
    >
      {%- if section.settings.logo -%}
        {%- render 'image',
          image: section.settings.logo,
          width: logo_image_width,
          sizes: logo_sizes,
          desktop_height: 'image-height',
          mobile_height: 'image-height--mobile',
          loading: 'lazy',
          show_backfill: false
        -%}
      {%- else -%}
        {{ 'logo' | placeholder_svg_tag: 'svg-placeholder' }}
      {%- endif -%}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Image",
      "info": "3200 x 1200px .jpg recommended. [Learn more](http://presidiodev.com/link/broadcast/images)"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "ロゴの最大幅（PC）",
      "min": 120,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "logo_max_width_mobile",
      "label": "ロゴの最大幅（スマートフォン）",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Logo",
      "category": "Layout"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
