{%- liquid
  assign feature = product.metafields.ta_vie.feature.value
  assign feature_owned = false
  if product.id != blank and feature.owner_product.value.id == product.id
    assign feature_owned = true
  endif
  assign world_id = 'ProductWorld-' | append: section.id
  assign chapter_count = 0
  assign chapter_navigation = ''
  assign product_images = product.media | where: 'media_type', 'image'
-%}

{%- capture chapters -%}
  {%- for block in section.blocks -%}
    {%- if feature_owned or block.type == 'explorer' or block.type == 'description' or block.type == 'purchase' -%}
      {%- liquid
        assign chapter_id = world_id | append: '-' | append: block.id
        assign chapter_heading = block.settings.heading
        assign chapter_body = nil
        assign chapter_image = nil
        assign chapter_mobile_image = nil
        assign chapter_video = nil
        case block.type
          when 'description'
            assign chapter_image = product_images[1].preview_image
          when 'reason'
            assign chapter_heading = feature.reason_heading.value | default: chapter_heading
            assign chapter_body = feature.reason_body
            assign chapter_image = feature.reason_image.value
            assign chapter_mobile_image = feature.reason_mobile_image.value
          when 'material'
            assign chapter_heading = feature.material_heading.value | default: chapter_heading
            assign chapter_body = feature.material_body
            assign chapter_image = feature.material_image.value
            assign chapter_mobile_image = feature.material_mobile_image.value
            assign chapter_video = feature.material_video.value
          when 'fit'
            assign chapter_body = feature.fit_body
          when 'care'
            assign chapter_body = feature.care_body
          when 'making'
            assign chapter_body = feature.making_body
        endcase
      -%}
      {%- capture chapter_media -%}
        {%- if chapter_video.media_type == 'video' -%}
          <div class="tv-world__media tv-world__media--video">
            {{ chapter_video | video_tag: controls: true, autoplay: false, loop: false, muted: false, preload: 'none', image_size: '1200x' }}
            {%- assign video_fallback = chapter_image | default: chapter_video.preview_image -%}
            {%- if video_fallback != blank -%}<div data-tv-world-video-fallback hidden>{{ video_fallback | image_url: width: 1500 | image_tag: widths: '400, 750, 1100, 1500', sizes: '(min-width: 990px) 48vw, calc(100vw - 40px)', loading: 'lazy', alt: video_fallback.alt }}</div>{%- endif -%}
          </div>
        {%- elsif chapter_image != blank or chapter_mobile_image != blank -%}
          {%- assign media_image = chapter_image | default: chapter_mobile_image -%}
          <figure class="tv-world__media">
            <picture>
              {%- if chapter_mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ chapter_mobile_image | image_url: width: 500 }} 500w, {{ chapter_mobile_image | image_url: width: 900 }} 900w" sizes="calc(100vw - 40px)">{%- endif -%}
              {{ media_image | image_url: width: 1500 | image_tag: widths: '400, 750, 1100, 1500', sizes: '(min-width: 990px) 48vw, calc(100vw - 40px)', loading: 'lazy', alt: media_image.alt }}
            </picture>
          </figure>
        {%- endif -%}
      {%- endcapture -%}
      {%- capture chapter_content -%}
        {%- case block.type -%}
          {%- when 'explorer' -%}
            {%- render 'ta-vie-luxury-explorer', product: product, explorer_id: chapter_id, eager: false, context: 'product' -%}
          {%- when 'description' -%}
            {%- if section.settings.show_description and product.description != blank and product.description != '<!---->' -%}
              <div class="tv-world__split{% if chapter_media == blank %} tv-world__split--text{% endif %}">
                {{ chapter_media }}
                <div class="tv-world__copy"><div class="tv-world__body rte">{{ product.description }}</div></div>
              </div>
            {%- endif -%}
          {%- when 'reason', 'material' -%}
            {%- if chapter_body.value != blank or chapter_media != blank -%}
              <div class="tv-world__split{% if chapter_media == blank %} tv-world__split--text{% elsif chapter_body.value == blank %} tv-world__split--media{% endif %}">
                {{ chapter_media }}
                {%- if chapter_body.value != blank -%}<div class="tv-world__copy"><div class="tv-world__body rte">{{ chapter_body | metafield_tag }}</div></div>{%- endif -%}
              </div>
            {%- endif -%}
          {%- when 'scenes' -%}
            {%- assign visible_scenes = 0 -%}
            {%- capture scene_content -%}
              {%- for scene in feature.scenes.value limit: 3 -%}
                {%- if scene.owner_product.value.id == product.id and scene.label.value != blank -%}
                  {%- if scene.body.value != blank or scene.image.value != blank or scene.mobile_image.value != blank or scene.video.value.media_type == 'video' -%}
                    {%- assign visible_scenes = visible_scenes | plus: 1 -%}
                    <details class="tv-world__scene"{% if visible_scenes == 1 %} open{% endif %}>
                      <summary>{{ scene.label.value | escape }}<span aria-hidden="true">＋</span></summary>
                      <div class="tv-world__scene-content tv-world__split{% if scene.image.value == blank and scene.mobile_image.value == blank and scene.video.value.media_type != 'video' %} tv-world__split--text{% endif %}">
                        {%- if scene.video.value.media_type == 'video' -%}
                          <div class="tv-world__media tv-world__media--video">{{ scene.video.value | video_tag: controls: true, autoplay: false, loop: false, muted: false, preload: 'none', image_size: '1200x' }}
                            {%- assign scene_video_fallback = scene.image.value | default: scene.video.value.preview_image -%}
                            {%- if scene_video_fallback != blank -%}<div data-tv-world-video-fallback hidden>{{ scene_video_fallback | image_url: width: 1500 | image_tag: widths: '400, 750, 1100, 1500', sizes: '(min-width: 990px) 48vw, calc(100vw - 40px)', loading: 'lazy', alt: scene_video_fallback.alt }}</div>{%- endif -%}
                          </div>
                        {%- elsif scene.image.value != blank or scene.mobile_image.value != blank -%}
                          {%- assign scene_image = scene.image.value | default: scene.mobile_image.value -%}
                          <figure class="tv-world__media"><picture>
                            {%- if scene.mobile_image.value != blank -%}<source media="(max-width: 749px)" srcset="{{ scene.mobile_image.value | image_url: width: 500 }} 500w, {{ scene.mobile_image.value | image_url: width: 900 }} 900w" sizes="calc(100vw - 40px)">{%- endif -%}
                            {{ scene_image | image_url: width: 1500 | image_tag: widths: '400, 750, 1100, 1500', sizes: '(min-width: 990px) 48vw, calc(100vw - 40px)', loading: 'lazy', alt: scene_image.alt }}
                          </picture></figure>
                        {%- endif -%}
                        <div class="tv-world__copy">
                          {%- if scene.heading.value != blank -%}<h3 class="tv-world__subheading">{{ scene.heading.value | escape }}</h3>{%- endif -%}
                          {%- if scene.body.value != blank -%}<div class="tv-world__body rte">{{ scene.body | metafield_tag }}</div>{%- endif -%}
                        </div>
                      </div>
                    </details>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if visible_scenes > 0 -%}<div class="tv-world__scenes">{{ scene_content }}</div>{%- endif -%}
          {%- when 'fit' -%}
            {%- if chapter_body.value != blank -%}<div class="tv-world__copy tv-world__copy--reading"><div class="tv-world__body rte">{{ chapter_body | metafield_tag }}</div></div>{%- endif -%}
            {%- capture size_rows -%}
              {%- for row in feature.size_rows.value limit: 12 -%}
                {%- if row.owner_product.value.id == product.id and row.label.value != blank -%}
                  {%- if row.length.value != blank or row.chest.value != blank or row.sleeve.value != blank or row.waist.value != blank or row.inseam.value != blank -%}
                    <tr><th scope="row">{{ row.label.value | escape }}</th><td>{{ row.length.value | default: '—' | escape }}</td><td>{{ row.chest.value | default: '—' | escape }}</td><td>{{ row.sleeve.value | default: '—' | escape }}</td><td>{{ row.waist.value | default: '—' | escape }}</td><td>{{ row.inseam.value | default: '—' | escape }}</td></tr>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- assign size_rows = size_rows | strip -%}
            {%- if size_rows != blank -%}<div class="tv-world__table-wrap" tabindex="0" role="region" aria-label="商品実寸表"><table class="tv-world__table"><caption>{{ block.settings.table_label | default: '商品実寸' | escape }}</caption><thead><tr><th scope="col">サイズ</th><th scope="col">着丈</th><th scope="col">身幅</th><th scope="col">袖丈</th><th scope="col">ウエスト</th><th scope="col">股下</th></tr></thead><tbody>{{ size_rows }}</tbody></table></div>{%- endif -%}
          {%- when 'care', 'making' -%}
            {%- if chapter_body.value != blank -%}<div class="tv-world__copy tv-world__copy--reading"><div class="tv-world__body rte">{{ chapter_body | metafield_tag }}</div></div>{%- endif -%}
          {%- when 'purchase' -%}
            <div class="tv-world__return">
              {%- if product.featured_image != blank -%}<figure class="tv-world__return-image">{{ product.featured_image | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '(min-width: 750px) 280px, 32vw', loading: 'lazy', alt: product.featured_image.alt }}</figure>{%- endif -%}
              <div><p class="tv-world__eyebrow">TA VIE</p><p class="tv-world__return-title">{{ product.title | escape }}</p><a class="tv-world__purchase-link" href="#TaViePurchase-{{ product.id }}" data-tv-world-purchase>{{ block.settings.button_label | default: '色・サイズを選ぶ' | escape }}<span aria-hidden="true">↗</span></a></div>
            </div>
        {%- endcase -%}
      {%- endcapture -%}
      {%- assign chapter_content = chapter_content | strip -%}
      {%- if chapter_content != blank -%}
        {%- assign chapter_count = chapter_count | plus: 1 -%}
        {%- capture chapter_link -%}<a href="#{{ chapter_id }}" data-tv-world-chapter-link><span aria-hidden="true">{{ chapter_count | prepend: '0' }}</span>{{ chapter_heading | escape }}</a>{%- endcapture -%}
        {%- assign chapter_navigation = chapter_navigation | append: chapter_link -%}
        <section id="{{ chapter_id }}" class="tv-world__chapter tv-world__chapter--{{ block.type }}" data-tv-world-chapter data-tv-world-kind="{{ block.type }}" aria-labelledby="{{ chapter_id }}-heading" {{ block.shopify_attributes }}>
          <header class="tv-world__chapter-header"><p class="tv-world__eyebrow">{{ chapter_count | prepend: '0' }}</p><h2 id="{{ chapter_id }}-heading" class="tv-world__heading">{{ chapter_heading | escape }}</h2></header>
          {{ chapter_content }}
        </section>
      {%- elsif request.design_mode -%}
        <div class="tv-world__editor-note" {{ block.shopify_attributes }}>「{{ chapter_heading | escape }}」には、この商品の写真・説明を設定してください。未設定の章は公開画面には表示しません。</div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if product.id != blank -%}
  <ta-vie-product-world id="{{ world_id }}" class="tv-world color-{{ section.settings.color_scheme }}" data-product-id="{{ product.id }}" data-section-id="{{ section.id }}" style="--tv-world-pt:{{ section.settings.padding_top }}px;--tv-world-pb:{{ section.settings.padding_bottom }}px;">
    <div class="tv-world__inner">
      {%- if chapter_count > 0 -%}
        <header class="tv-world__intro"><p class="tv-world__eyebrow">THE PIECE / {{ product.title | escape }}</p><h2 class="tv-world__intro-heading">{{ section.settings.heading | escape }}</h2>
          {%- if feature_owned and feature.lead.value != blank -%}<p class="tv-world__lead">{{ feature.lead.value | escape }}</p>{%- endif -%}
        </header>
        {%- if section.settings.show_chapter_nav -%}<nav class="tv-world__chapter-nav" data-tv-world-nav aria-label="この一着を知る">{{ chapter_navigation }}</nav>{%- endif -%}
        {{ chapters }}
      {%- endif -%}
      {%- if section.settings.show_product_nav -%}
        {%- liquid
          assign nav_collection = section.settings.collection | default: collections.all
          assign explicit_ids = '|'
          for index in (1..4)
            assign picker_id = 'product_' | append: index
            assign picked = section.settings[picker_id]
            if picked != blank
              assign picked_token = picked.id | prepend: '|' | append: '|'
              assign explicit_ids = explicit_ids | append: picked_token
            endif
          endfor
          assign shown_ids = '|'
          assign nav_count = 0
        -%}
        {%- capture product_navigation -%}
          {%- for index in (1..4) -%}
            {%- liquid
              assign picker_id = 'product_' | append: index
              assign nav_product = section.settings[picker_id]
              if nav_product == blank
                for candidate in nav_collection.products
                  assign candidate_token = candidate.id | prepend: '|' | append: '|'
                  unless explicit_ids contains candidate_token or shown_ids contains candidate_token
                    assign nav_product = candidate
                    break
                  endunless
                endfor
              endif
              assign nav_token = nav_product.id | prepend: '|' | append: '|'
            -%}
            {%- if nav_product != blank and nav_product.id != blank -%}
              {%- unless shown_ids contains nav_token -%}
                {%- assign shown_ids = shown_ids | append: nav_token -%}
                {%- assign nav_count = nav_count | plus: 1 -%}
                <a class="tv-world__product-card{% if nav_product.id == product.id %} is-current{% endif %}" href="{{ nav_product.url }}"{% if nav_product.id == product.id %} aria-current="page"{% endif %}>
                  {%- if nav_product.featured_image != blank -%}<figure class="tv-world__product-card-image">{{ nav_product.featured_image | image_url: width: 700 | image_tag: widths: '300, 500, 700', sizes: '(min-width: 990px) 23vw, (min-width: 750px) 44vw, 68vw', loading: 'lazy', alt: nav_product.featured_image.alt }}</figure>{%- endif -%}
                  <span class="tv-world__card-number" aria-hidden="true">{{ nav_count | prepend: '0' }}</span><span class="tv-world__card-title">{{ nav_product.title | escape }}</span><span class="tv-world__card-action">{% if nav_product.id == product.id %}今見ている一着{% else %}この一着を知る <span aria-hidden="true">↗</span>{% endif %}</span>
                </a>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if nav_count > 0 -%}<nav class="tv-world__product-nav" aria-label="TA VIEの一着を選ぶ"><header class="tv-world__product-nav-header"><h2 class="tv-world__heading">{{ section.settings.navigation_heading | escape }}</h2><a href="{{ routes.all_products_collection_url }}">すべての一着を見る <span aria-hidden="true">↗</span></a></header><div class="tv-world__product-cards">{{ product_navigation }}</div></nav>{%- endif -%}
      {%- endif -%}
      <a class="tv-world__back" href="{{ routes.root_url }}#piece-{{ product.handle }}">ホームの特集へ戻る <span aria-hidden="true">↗</span></a>
      {%- if request.design_mode and feature != blank and feature_owned == false -%}<p class="tv-world__editor-note">商品特集の「この内容の商品」が現在の商品と一致していません。その商品専用のエントリーを設定してください。</p>{%- endif -%}
    </div>
  </ta-vie-product-world>
{%- endif -%}

{% schema %}
{
  "name": "TA VIE 一着の特集",
  "tag": "section",
  "enabled_on": {"templates": ["product"]},
  "max_blocks": 9,
  "settings": [
    {"type":"paragraph","content":"写真切替は商品メタフィールド「TA VIE｜写真の切り替え」（ta_vie.views）、文章・生活場面・寸法は「TA VIE｜商品特集」（ta_vie.feature）で、この商品専用の内容を編集します。ここでは共通の構成を整えます。"},
    {"type":"text","id":"heading","label":"特集の見出し","default":"一着の魅力を、ゆっくりと。"},
    {"type":"checkbox","id":"show_description","label":"商品管理画面の説明を表示","info":"実際の商品説明を表示します。空欄なら章を表示しません。","default":true},
    {"type":"checkbox","id":"show_chapter_nav","label":"特集の目次を表示","default":true},
    {"type":"header","content":"他の一着への案内"},
    {"type":"checkbox","id":"show_product_nav","label":"写真付きの商品ナビを表示","default":true},
    {"type":"text","id":"navigation_heading","label":"商品ナビの見出し","default":"次に気になる一着へ。"},
    {"type":"collection","id":"collection","label":"紹介する商品のコレクション","info":"個別に選んでいない枠には、このコレクションの商品を順に表示します。未選択なら全商品を使います。"},
    {"type":"product","id":"product_1","label":"紹介する一着 1"},
    {"type":"product","id":"product_2","label":"紹介する一着 2"},
    {"type":"product","id":"product_3","label":"紹介する一着 3"},
    {"type":"product","id":"product_4","label":"紹介する一着 4"},
    {"type":"color_scheme","id":"color_scheme","label":"配色","default":"scheme-1"},
    {"type":"range","id":"padding_top","label":"上の余白","min":0,"max":160,"step":8,"unit":"px","default":80},
    {"type":"range","id":"padding_bottom","label":"下の余白","min":0,"max":160,"step":8,"unit":"px","default":80}
  ],
  "blocks": [
    {"type":"explorer","name":"写真と細部を操作する","limit":1,"settings":[{"type":"text","id":"heading","label":"見出し","default":"写真から、この一着を知る。"},{"type":"paragraph","content":"商品専用の写真・切替名・細部の接写を商品管理画面で設定します。未設定の場合は実際の商品写真を表示します。"}]},
    {"type":"description","name":"商品説明","limit":1,"settings":[{"type":"text","id":"heading","label":"見出し","default":"この一着について"}]},
    {"type":"reason","name":"この一着を作った理由","limit":1,"settings":[{"type":"text","id":"heading","label":"共通の見出し","default":"この一着を作った理由"}]},
    {"type":"material","name":"素材を知る","limit":1,"settings":[{"type":"text","id":"heading","label":"共通の見出し","default":"肌に触れる、その素材。"}]},
    {"type":"scenes","name":"家で過ごす姿","limit":1,"settings":[{"type":"text","id":"heading","label":"共通の見出し","default":"この一着と過ごす時間。"}]},
    {"type":"fit","name":"サイズと着用感","limit":1,"settings":[{"type":"text","id":"heading","label":"見出し","default":"サイズと着用感"},{"type":"text","id":"table_label","label":"実寸表の見出し","default":"商品実寸"}]},
    {"type":"care","name":"お手入れ","limit":1,"settings":[{"type":"text","id":"heading","label":"見出し","default":"長くそばに置くために。"}]},
    {"type":"making","name":"仕立てと製造背景","limit":1,"settings":[{"type":"text","id":"heading","label":"見出し","default":"仕立てと製造背景"}]},
    {"type":"purchase","name":"購入欄へ戻る","limit":1,"settings":[{"type":"text","id":"heading","label":"見出し","default":"この一着を選ぶ"},{"type":"text","id":"button_label","label":"リンクの表示","default":"色・サイズを選ぶ"}]}
  ],
  "presets":[{"name":"TA VIE 一着の特集","blocks":[{"type":"explorer"},{"type":"description"},{"type":"reason"},{"type":"material"},{"type":"scenes"},{"type":"fit"},{"type":"care"},{"type":"making"},{"type":"purchase"}]}]
}
{% endschema %}
