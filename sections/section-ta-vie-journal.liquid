{%- liquid
  assign reading_blog = settings.tvj_blog | default: settings.ta_vie_blog
  if reading_blog != blank and reading_blog.url == blank
    assign reading_blog = blogs[reading_blog]
  endif
  if reading_blog.url == blank
    assign reading_blog = blogs.news
  endif
  assign recommended_article = section.settings.featured_article | default: settings.tvj_featured
  if recommended_article != blank and recommended_article.url == blank
    assign recommended_article = articles[recommended_article]
  endif
  assign now_timestamp = 'now' | date: '%s' | plus: 0
  assign recommendation_timestamp = recommended_article.published_at | date: '%s' | plus: 0
  if recommended_article.url == blank or recommended_article.published_at == blank or recommendation_timestamp <= 0 or recommendation_timestamp > now_timestamp
    assign recommended_article = nil
    for candidate in reading_blog.articles
      assign candidate_timestamp = candidate.published_at | date: '%s' | plus: 0
      if candidate.url != blank and candidate.published_at != blank and candidate_timestamp > 0 and candidate_timestamp <= now_timestamp
        assign recommended_article = candidate
        break
      endif
    endfor
  endif
  assign article_limit = section.settings.article_count | default: 6
  assign other_article_count = 0
-%}
{%- render 'stylesheet', name: 'ta-vie-journal.css', blocking: true, async: false, inline: false -%}
{%- style -%}
  #TaVieJournal-{{ section.id }} { --tvj-padding-top: {{ section.settings.padding_top }}px; --tvj-padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}
<div id="TaVieJournal-{{ section.id }}" class="tvj-journal color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}" data-section-type="ta-vie-journal">
  <div class="tvj-journal__inner">
    <header class="tvj-journal__introduction">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="tvj-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="tvj-journal__heading">{{ section.settings.heading | default: page.title | escape }}</h1>
      </div>
      {%- if section.settings.body != blank -%}<div class="tvj-journal__body">{{ section.settings.body }}</div>{%- endif -%}
    </header>

    {%- if recommended_article != blank -%}
      <section class="tvj-journal__featured" aria-label="おすすめの読みもの">
        <p class="tvj-eyebrow">{{ section.settings.featured_label | escape }}</p>
        {%- render 'ta-vie-journal-card', article: recommended_article, featured: true, show_date: true, show_updated: section.settings.show_updated, link_label: section.settings.article_link_label -%}
      </section>
    {%- endif -%}

    {%- if reading_blog.all_tags.size > 0 -%}
      <nav class="tvj-journal__categories" aria-label="記事のテーマから探す">
        <p class="tvj-eyebrow">{{ section.settings.category_label | escape }}</p>
        <ul class="tvj-journal__category-list" role="list">
          <li><a class="tvj-category" href="{{ reading_blog.url | escape }}">すべての記事</a></li>
          {%- for tag in reading_blog.all_tags -%}
            <li><a class="tvj-category" href="{{ reading_blog.url | escape }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- capture other_articles -%}
      {%- for journal_article in reading_blog.articles -%}
        {%- assign publication_timestamp = journal_article.published_at | date: '%s' | plus: 0 -%}
        {%- if journal_article.url != recommended_article.url and journal_article.url != blank and journal_article.published_at != blank and publication_timestamp > 0 and publication_timestamp <= now_timestamp -%}
          {%- render 'ta-vie-journal-card', article: journal_article, show_date: true, show_updated: section.settings.show_updated, link_label: section.settings.article_link_label -%}
          {%- assign other_article_count = other_article_count | plus: 1 -%}
          {%- if other_article_count >= article_limit -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if other_article_count > 0 -%}
      <section class="tvj-journal__latest" aria-labelledby="TaVieJournalLatest-{{ section.id }}">
        <h2 id="TaVieJournalLatest-{{ section.id }}" class="tvj-section-heading">{{ section.settings.latest_heading | escape }}</h2>
        <div class="tvj-grid">{{ other_articles }}</div>
      </section>
    {%- endif -%}
    {%- if reading_blog.url != blank -%}
      <div class="tvj-journal__archive"><a class="tvj-link" href="{{ reading_blog.url | escape }}"><span>{{ section.settings.archive_label | escape }}</span><span aria-hidden="true">→</span></a><p class="tvj-journal__archive-note">過去の記事は、ブログ一覧のページ送りからご覧いただけます。</p></div>
    {%- endif -%}
    {%- if section.settings.show_timeline -%}<div id="TaVieJournalTimeline" class="tvj-journal__timeline">{%- render 'ta-vie-timeline', context: 'journal', limit: section.settings.timeline_count -%}</div>{%- endif -%}
    {%- if section.settings.show_social -%}{%- render 'ta-vie-social', context: 'journal' -%}{%- endif -%}
    {%- if request.design_mode and reading_blog.url == blank -%}
      <p class="tvj-editor-note">テーマ設定「TA VIE｜Journalと発信」のブログを選択すると、既存の公開済み記事を読み込みます。この記事紹介は元の記事本文・URL・公開日を変更しません。</p>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "TA VIE｜Journal特集",
  "enabled_on": {"templates": ["page"]},
  "settings": [
    {"type": "header", "content": "Journalの入口"},
    {"type": "paragraph", "content": "記事はテーマ設定で選んだ既存ブログから読み込みます。記事本文と既存ブログのURL・表示は変更しません。"},
    {"type": "text", "id": "eyebrow", "label": "小さな見出し", "default": "LIFE AT HOME"},
    {"type": "text", "id": "heading", "label": "ページの見出し", "default": "Journal"},
    {"type": "richtext", "id": "body", "label": "紹介文", "default": "<p>一着のこと、素材のこと、家で過ごす時間のこと。TA VIEの読みものを、ここから。</p>"},
    {"type": "article", "id": "featured_article", "label": "このLPのおすすめ記事", "info": "未選択ならテーマ設定のおすすめ記事、次に最新の公開済み記事を使います。"},
    {"type": "text", "id": "featured_label", "label": "おすすめ記事の小見出し", "default": "EDITOR’S PICK"},
    {"type": "text", "id": "latest_heading", "label": "記事一覧の見出し", "default": "読みもの"},
    {"type": "range", "id": "article_count", "label": "おすすめ以外の記事数", "min": 6, "max": 12, "step": 1, "default": 6},
    {"type": "checkbox", "id": "show_updated", "label": "記事の最終更新日も表示", "default": false, "info": "公開日とは別に表示します。表示を有効にしても記事の並び順は公開日基準です。"},
    {"type": "text", "id": "article_link_label", "label": "記事を読むリンク", "default": "記事を読む"},
    {"type": "text", "id": "category_label", "label": "タグ一覧の小見出し", "default": "テーマから読む"},
    {"type": "text", "id": "archive_label", "label": "既存ブログ一覧へのリンク", "default": "すべての記事・過去の記事を見る"},
    {"type": "header", "content": "お知らせとInstagram"},
    {"type": "checkbox", "id": "show_timeline", "label": "お知らせタイムラインを表示", "default": true},
    {"type": "range", "id": "timeline_count", "label": "タイムラインの初期表示件数", "min": 3, "max": 20, "step": 1, "default": 10, "info": "過去のお知らせへの操作はタイムライン内に表示されます。"},
    {"type": "checkbox", "id": "show_social", "label": "Instagramとライブ案内を表示", "default": true},
    {"type": "header", "content": "配色と余白"},
    {"type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-tavie-white"},
    {"type": "range", "id": "padding_top", "label": "上の余白", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80},
    {"type": "range", "id": "padding_bottom", "label": "下の余白", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80}
  ],
  "presets": [{"name": "TA VIE｜Journal特集"}]
}
{% endschema %}
