{%- render 'ta-vie-home-reduced-motion' -%}
<!-- /sections/section-product.liquid -->
{%- liquid
  assign product = all_products[section.settings.product]
  assign unique = section.id
  assign show_recently_viewed_indicator = settings.show_recently_viewed_indicator
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign limit = section.settings.limit
  assign featured_image = section.settings.image
  assign featured_image_mobile = section.settings.image_mobile
  assign product_images = product.media | where: 'media_type', 'image'
  assign product_images_count = product_images.size | at_most: limit
  assign offset = 1
  assign ta_vie_has_product = false
  if product.id != blank and product.url != blank
    assign ta_vie_has_product = true
  endif
  assign ta_vie_text_only = false
  if section.settings.ta_vie_hide_unconfigured and product.featured_image == blank
    assign ta_vie_text_only = true
  endif
  if product_images_count < 2
    assign offset = 0
  endif

  if product == blank
    assign product_images_count = limit
  endif

  capture grid_item_sizes
    echo '(min-width: 750px) 25vw, calc(100vw - 32px)'
  endcapture

  capture product_images_sizes
    echo '(min-width: 990px) calc(50vw - 200px), (min-width: 750px) calc(50vw - 100px), calc(100vw - 100px)'
  endcapture
-%}

{%- if section.settings.ta_vie_hide_unconfigured and ta_vie_has_product == false -%}
  {%- render 'ta-vie-home-editor-note', message: 'この「一着の特集」で紹介する実際の商品を、Productから選んでください。商品写真と価格は選んだ商品に連動します。4枠は別々に選択・並べ替えできます。未選択の枠は公開画面に表示しません。' -%}
{%- else -%}
{%- render 'stylesheet', name: 'featured-product.css' -%}

<script src="{{ 'featured-product.js' | asset_url }}" defer="defer"></script>

{%- if show_recently_viewed_indicator -%}
  <script src="{{ 'grid-item.js' | asset_url }}" defer></script>
{%- endif -%}

{%- if settings.quickview_enable -%}
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  {%- if section.settings.ta_vie_hide_unconfigured -%}
    #Product--{{ unique }} .featured-product__card { gap: 24px; }
    #Product--{{ unique }} .product-item__title { display: none; }
    #Product--{{ unique }} .ta-vie-featured-intro { max-width: 36em; }
    #Product--{{ unique }} .ta-vie-featured-intro h2 { margin-top: 0; }
    #Product--{{ unique }} .ta-vie-featured-intro p { line-height: 1.8; }
    @media screen and (min-width: 750px) {
      #Product--{{ unique }} .featured-product__card { flex-basis: 72%; max-width: 42rem; }
    }
    @media screen and (max-width: 749px) {
      #Product--{{ unique }} .featured-product__content { position: relative; top: auto; }
      #Product--{{ unique }} .featured-product__body { min-height: 0; }
    }
  {%- endif -%}
  {%- if ta_vie_text_only -%}
    #Product--{{ unique }} .featured-product__body { min-height: auto; padding: 48px var(--outer); }
    #Product--{{ unique }} .featured-product__content { position: static; flex-basis: 100%; min-height: auto; }
  {%- endif -%}
  {%- if request.visual_preview_mode -%}
    .featured-product__body { min-height: initial; }
    .featured-product__content { margin: auto; }
    .featured-product__image:not(:first-child) { display: none; }
  {%- endif -%}
{%- endstyle -%}

<featured-product
  id="Product--{{ unique }}"
  class="featured-product featured-product--{{ section.settings.scrolling_styles }} {% if section.settings.horizontal_scroll %} featured-product--full-width{% endif %} {{ section.settings.layout }} {{ color_scheme }}"
  {% if section.settings.scrolling_styles == 'horizontal' %}
    data-horizontal-scroll
  {% endif %}
  {% if section.settings.scrolling_styles == 'horizontal' and section.settings.layout == 'is-reversed' %}
    data-horizontal-scroll-reversed
  {% endif %}
  data-section-id="{{ unique }}"
  data-section-type="featured-product"
>
  <div class="featured-product__body" data-featured-wrapper>
    {%- if featured_image_mobile != blank -%}
      <div class="featured-product__bg mobile">
        {%- render 'image',
          image: featured_image_mobile,
          widths: '365, 550, 730, 1100, 1460, 1640, 1920, 2200',
          sizes: '100vw',
          cover: true
        -%}
      </div>
    {%- endif -%}

    <div class="featured-product__content" data-featured-content>
      <div class="featured-product__card">
        {%- if section.settings.ta_vie_hide_unconfigured and ta_vie_has_product -%}
          <div class="ta-vie-featured-intro">
            <h2 class="heading-medium">{{ product.title | strip_html | escape }}</h2>
            {%- if product.description != blank -%}
              <p class="body-medium">{{ product.description | strip_html | truncate: 180 | escape }}</p>
            {%- endif -%}
            {%- if ta_vie_text_only -%}
              {%- render 'price', product: product, use_variant: false, show_badges: false, price_font_size: 'body-medium' -%}
            {%- endif -%}
            <a class="btn btn--primary btn--text" href="{{ product.url | escape }}"><span>この一着を詳しく見る</span>{%- render 'icon-nav-arrow-right' -%}</a>
          </div>
        {%- endif -%}
        {%- if product != blank and ta_vie_text_only == false -%}
          {%- render 'product-grid-item',
            product: product,
            index: forloop.index,
            show_product_card: section.settings.show_product_card,
            sizes: grid_item_sizes,
            disable_image_hover: true
          -%}
        {%- elsif product == blank -%}
          {%- render 'onboarding-product-grid-item',
            show_product_card: section.settings.show_product_card,
            index: forloop.index
          -%}
        {%- endif -%}
      </div>
    </div>

    {%- unless ta_vie_text_only -%}
    <div
      class="featured-product__aside{% if featured_image != blank %} featured-product__aside--bg{% endif %}"
      {% if product_images_count > 1 %}
        style="--images-count: {{ product_images_count }};"
      {% endif %}
      data-featured-aside
    >
      {%- if featured_image != blank -%}
        <div class="featured-product__bg desktop">
          {%- render 'image',
            image: featured_image,
            widths: '365, 550, 730, 1100, 1460, 1640, 1920, 2200',
            sizes: '(min-width: 750px) 50vw, 100vw',
            cover: true
          -%}
        </div>
      {%- endif -%}

      <div class="featured-product__inner">
        <div class="featured-product__images" data-featured-images>
          {%- if product != blank -%}
            {%- for image in product_images offset: offset limit: limit -%}
              <div class="featured-product__image" data-featured-image>
                {%- render 'image', image: image, sizes: product_images_sizes -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for index in (1..limit) -%}
              <div class="featured-product__image" data-featured-image>
                {%- assign placeholder = 'product-' | append: index -%}
                {%- render 'image', placeholder: placeholder -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- endunless -%}
  </div>
</featured-product>
{%- endif -%}

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "header",
      "content": "TA VIE｜公開時の表示"
    },
    {
      "type": "checkbox",
      "id": "ta_vie_hide_unconfigured",
      "label": "未設定の写真・商品を公開しない",
      "default": false,
      "info": "このセクションだけに適用します。写真や商品を選ぶとBroadcast標準の表示・動きが使われます。設定案内はテーマエディタだけに表示します。"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_product_card",
      "label": "Show product card",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "",
      "options": [
        {"value": "", "label": "Product left, image right"},
        {"value": "is-reversed", "label": "Image left, product right"}
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Images limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "2000 x 1400px .jpg recommended. [Learn more](http://presidiodev.com/link/broadcast/images)"
    },
    {
      "type": "select",
      "id": "scrolling_styles",
      "label": "Scrolling styles",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "checkbox",
      "id": "horizontal_scroll",
      "visible_if": "{{ section.settings.scrolling_styles == 'horizontal' and section.settings.image == blank }}",
      "label": "Full-width scroll",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image",
      "info": "1200 x 1600px .jpg recommended. [Learn more](http://presidiodev.com/link/broadcast/images)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    }
  ],
  "presets": [
    {
      "name": "Featured product",
      "category": "Products"
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "custom.pre_footer", "footer"]
  }
}
{% endschema %}
