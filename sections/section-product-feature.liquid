{%- liquid
  assign feature = product.metafields.ta_vie.feature.value
  assign feature_owned = false
  if product.id != blank and feature.owner_product.value.id == product.id
    assign feature_owned = true
  endif
  assign feature_id = 'ProductFeature--' | append: section.id
  assign feature_chapter_count = 0
  assign feature_navigation = ''
-%}

{%- if feature_owned -%}
  {%- capture feature_chapters -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign chapter_id = 'FeatureChapter--' | append: section.id | append: '--' | append: block.id
        assign chapter_heading = block.settings.heading
        assign chapter_image = nil
        assign chapter_mobile_image = nil
        assign chapter_video = nil
        assign chapter_body = nil
        assign chapter_is_split = false
        assign chapter_is_purchase = false
        case block.type
          when 'reason'
            assign chapter_heading = feature.reason_heading.value | default: chapter_heading
            assign chapter_body = feature.reason_body
            assign chapter_image = feature.reason_image.value
            assign chapter_mobile_image = feature.reason_mobile_image.value
            assign chapter_is_split = true
          when 'material'
            assign chapter_heading = feature.material_heading.value | default: chapter_heading
            assign chapter_body = feature.material_body
            assign chapter_image = feature.material_image.value
            assign chapter_mobile_image = feature.material_mobile_image.value
            assign chapter_video = feature.material_video.value
            assign chapter_is_split = true
          when 'fit'
            assign chapter_body = feature.fit_body
          when 'care'
            assign chapter_body = feature.care_body
          when 'making'
            assign chapter_body = feature.making_body
          when 'purchase'
            assign chapter_is_purchase = true
        endcase
        assign chapter_has_media = false
        if chapter_image != blank or chapter_mobile_image != blank or chapter_video.media_type == 'video'
          assign chapter_has_media = true
        endif
        if chapter_heading == blank
          case block.type
            when 'reason'
              assign chapter_heading = 'この一着を作った理由'
            when 'material'
              assign chapter_heading = '素材を知る'
            when 'details'
              assign chapter_heading = '細部を知る'
            when 'scenes'
              assign chapter_heading = '家で過ごす姿を想像する'
            when 'fit'
              assign chapter_heading = 'サイズと着用感'
            when 'care'
              assign chapter_heading = '長く着るために'
            when 'making'
              assign chapter_heading = '仕立てと製造背景'
            when 'purchase'
              assign chapter_heading = 'この一着を選ぶ'
          endcase
        endif
      -%}
      {%- capture chapter_content -%}
        {%- if chapter_is_split -%}
          {%- if chapter_body.value != blank or chapter_has_media -%}
            <div class="ta-vie-feature__split{% unless chapter_has_media %} ta-vie-feature__split--text-only{% endunless %}{% if chapter_has_media and chapter_body.value == blank %} ta-vie-feature__split--media-only{% endif %}">
              {%- render 'ta-vie-feature-media', image: chapter_image, mobile_image: chapter_mobile_image, video: chapter_video -%}
              {%- if chapter_body.value != blank -%}
                <div class="ta-vie-feature__copy">
                  <div class="ta-vie-feature__body rte">{{ chapter_body | metafield_tag }}</div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- elsif block.type == 'details' -%}
          {%- render 'ta-vie-feature-tabs', items: feature.details.value, product: product, item_type: 'details', group_id: chapter_id, group_label: chapter_heading -%}
        {%- elsif block.type == 'scenes' -%}
          {%- render 'ta-vie-feature-tabs', items: feature.scenes.value, product: product, item_type: 'scenes', group_id: chapter_id, group_label: chapter_heading -%}
        {%- elsif block.type == 'fit' -%}
          {%- if chapter_body.value != blank -%}
            <div class="ta-vie-feature__copy ta-vie-feature__copy--wide"><div class="ta-vie-feature__body rte">{{ chapter_body | metafield_tag }}</div></div>
          {%- endif -%}
          {%- render 'ta-vie-feature-size', rows: feature.size_rows.value, product: product, table_label: block.settings.table_label -%}
        {%- elsif block.type == 'care' -%}
          {%- if chapter_body.value != blank -%}
            <details class="ta-vie-feature__accordion" open>
              <summary>{{ block.settings.summary | default: 'お手入れ方法' | escape }}</summary>
              <div class="ta-vie-feature__copy ta-vie-feature__copy--wide"><div class="ta-vie-feature__body rte">{{ chapter_body | metafield_tag }}</div></div>
            </details>
          {%- endif -%}
        {%- elsif block.type == 'making' -%}
          {%- if chapter_body.value != blank -%}
            <div class="ta-vie-feature__copy ta-vie-feature__copy--wide"><div class="ta-vie-feature__body rte">{{ chapter_body | metafield_tag }}</div></div>
          {%- endif -%}
        {%- elsif chapter_is_purchase -%}
          <div class="ta-vie-feature__purchase">
            <p class="ta-vie-feature__purchase-title">{{ product.title | escape }}</p>
            <a class="btn btn--primary btn--solid" href="#ta-vie-purchase-anchor" data-feature-purchase>{{ block.settings.button_label | default: '色・サイズと購入情報を確認' | escape }}</a>
          </div>
        {%- endif -%}
      {%- endcapture -%}
      {%- assign chapter_content = chapter_content | strip -%}
      {%- if chapter_content != blank -%}
        {%- liquid
          unless chapter_is_purchase
            assign feature_chapter_count = feature_chapter_count | plus: 1
          endunless
          capture chapter_navigation
            echo '<a href="#'
            echo chapter_id
            echo '">'
            echo chapter_heading | escape
            echo '</a>'
          endcapture
          assign feature_navigation = feature_navigation | append: chapter_navigation
        -%}
        <section id="{{ chapter_id }}" class="ta-vie-feature__chapter{% if chapter_is_purchase %} ta-vie-feature__chapter--purchase{% endif %}" data-feature-chapter aria-labelledby="{{ chapter_id }}--heading" {{ block.shopify_attributes }}>
          <div class="ta-vie-feature__chapter-header">
            {%- unless chapter_is_purchase -%}<p class="ta-vie-feature__eyebrow">{{ feature_chapter_count | prepend: '0' }}</p>{%- endunless -%}
            <h2 id="{{ chapter_id }}--heading" class="ta-vie-feature__heading">{{ chapter_heading | escape }}</h2>
          </div>
          {{ chapter_content }}
        </section>
      {%- elsif request.design_mode -%}
        <div class="ta-vie-feature__editor-note" {{ block.shopify_attributes }}>
          <p>「{{ chapter_heading | escape }}」の公開内容は未設定です。この商品の「TA VIE 商品特集」で、対応する文章・写真・情報を入力してください。ほかの商品に属する項目は表示しません。</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

{%- if feature_owned and feature_chapter_count > 0 -%}
  {%- render 'stylesheet', name: 'ta-vie-product-feature.css', async: false, inline: false, blocking: true -%}
  <script src="{{ 'ta-vie-product-feature.js' | asset_url }}" defer="defer"></script>
  <ta-vie-product-feature
    id="{{ feature_id }}"
    class="ta-vie-feature color-{{ section.settings.color_scheme }} ta-vie-feature--{{ section.settings.width }} ta-vie-feature--{{ section.settings.image_fit }}{% if section.settings.sticky_media %} ta-vie-feature--sticky{% endif %}"
    data-section-id="{{ section.id }}"
    data-feature-motion="{{ section.settings.motion }}"
    style="--feature-PT: {{ section.settings.padding_top }}px; --feature-PB: {{ section.settings.padding_bottom }}px; --feature-image-ratio: {{ section.settings.image_ratio }}; --feature-mobile-image-ratio: {{ section.settings.mobile_image_ratio }};"
  >
    <div class="ta-vie-feature__inner">
      {%- if section.settings.heading != blank -%}
        <header class="ta-vie-feature__intro"><p class="ta-vie-feature__eyebrow">TA VIE</p><h2 class="ta-vie-feature__intro-heading">{{ section.settings.heading | escape }}</h2></header>
      {%- endif -%}
      {%- if section.settings.show_chapter_nav and feature_navigation != blank -%}
        <nav class="ta-vie-feature__nav" aria-label="この一着を知る">{{ feature_navigation }}</nav>
      {%- endif -%}
      {{ feature_chapters }}
    </div>
  </ta-vie-product-feature>
{%- elsif request.design_mode -%}
  <div class="wrapper section-padding ta-vie-feature__editor-note" style="--PT: 24px; --PB: 24px;">
    {%- if feature != blank and feature_owned == false -%}
      <p>この商品特集の「対象商品」が現在の商品と一致していません。商品の「TA VIE 商品特集」で、この商品を対象にしたエントリーを選んでください。</p>
    {%- else -%}
      <p>商品管理画面の「TA VIE 商品特集」に、この商品専用の文章・写真・サイズ情報を設定すると特集が表示されます。未設定の章は公開画面に表示しません。</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "TA VIE 商品特集",
  "tag": "section",
  "enabled_on": {"templates": ["product"]},
  "max_blocks": 8,
  "settings": [
    {"type": "paragraph", "content": "商品ごとの内容は、商品管理画面の「TA VIE 商品特集」で編集します。ここでは共通の見出し・章の順番・見せ方を設定します。"},
    {"type": "text", "id": "heading", "label": "特集全体の見出し", "default": "この一着を、深く知る。"},
    {"type": "checkbox", "id": "show_chapter_nav", "label": "設定済みの章へのリンクを表示", "default": true},
    {"type": "select", "id": "width", "label": "表示幅", "default": "normal", "options": [{"value": "normal", "label": "標準"}, {"value": "wide", "label": "広く"}]},
    {"type": "select", "id": "image_fit", "label": "写真の収め方", "default": "contain", "options": [{"value": "contain", "label": "写真全体を見せる"}, {"value": "cover", "label": "枠いっぱいに見せる"}]},
    {"type": "select", "id": "image_ratio", "label": "PCでの写真の切り取り", "info": "「枠いっぱいに見せる」を選んだ場合の比率です。", "default": "4/5", "options": [{"value": "4/5", "label": "縦長"}, {"value": "1/1", "label": "正方形"}, {"value": "3/2", "label": "横長"}]},
    {"type": "select", "id": "mobile_image_ratio", "label": "スマートフォンの写真の切り取り", "info": "商品特集でスマートフォン専用の写真も選べます。", "default": "4/5", "options": [{"value": "4/5", "label": "縦長"}, {"value": "1/1", "label": "正方形"}, {"value": "3/2", "label": "横長"}]},
    {"type": "checkbox", "id": "sticky_media", "label": "PCでは写真を説明に沿って追従", "default": true},
    {"type": "checkbox", "id": "motion", "label": "控えめな写真の動きを使う", "info": "端末で動きを減らす設定を選んでいる場合は停止します。", "default": true},
    {"type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-1"},
    {"type": "range", "id": "padding_top", "label": "上の余白", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80},
    {"type": "range", "id": "padding_bottom", "label": "下の余白", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80}
  ],
  "blocks": [
    {"type": "reason", "name": "この一着を作った理由", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "共通の見出し", "info": "商品特集に専用見出しがある場合は、そちらを表示します。", "default": "この一着を作った理由"}]},
    {"type": "material", "name": "素材を知る", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "共通の見出し", "info": "商品特集に専用見出しがある場合は、そちらを表示します。", "default": "素材を知る"}]},
    {"type": "details", "name": "細部を知る", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "見出し", "default": "細部を知る"}, {"type": "paragraph", "content": "商品特集の「細部」に、この商品専用の写真と説明を最大6件設定します。"}]},
    {"type": "scenes", "name": "家で過ごす姿", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "見出し", "default": "家で過ごす姿を想像する"}, {"type": "paragraph", "content": "商品特集の「生活場面」に、この商品専用の写真・動画と説明を最大3件設定します。"}]},
    {"type": "fit", "name": "サイズと着用感", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "見出し", "default": "サイズと着用感"}, {"type": "text", "id": "table_label", "label": "実寸表の見出し", "default": "商品実寸"}, {"type": "paragraph", "content": "実寸は商品特集の「サイズ表」で最大12行設定します。数値にはcmなどの単位を含めてください。モデル情報とフィットは「着用感」に入力します。"}]},
    {"type": "care", "name": "お手入れ", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "見出し", "default": "長く着るために"}, {"type": "text", "id": "summary", "label": "開閉ボタンの表示", "default": "お手入れ方法"}]},
    {"type": "making", "name": "製造背景", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "見出し", "default": "仕立てと製造背景"}, {"type": "paragraph", "content": "原産国や製造方法など、確認できた情報だけを商品特集の「製造背景」に入力してください。"}]},
    {"type": "purchase", "name": "購入へ戻る", "limit": 1, "settings": [{"type": "text", "id": "heading", "label": "見出し", "default": "この一着を選ぶ"}, {"type": "text", "id": "button_label", "label": "ボタンの表示", "default": "色・サイズと購入情報を確認"}]}
  ],
  "presets": [
    {"name": "TA VIE 商品特集", "blocks": [{"type": "reason"}, {"type": "material"}, {"type": "details"}, {"type": "scenes"}, {"type": "fit"}, {"type": "care"}, {"type": "making"}, {"type": "purchase"}]}
  ]
}
{% endschema %}
